{
  "args" : [
    "--get-object-tagging",
    "-b",
    "bucket1",
    "-k",
    "key1",
    "--version-id",
    "v3",
    "--print=false"
  ],
  "routes" : [
    {
      "contains" : "GET /bucket1/key1?tagging",
      "responseBody" : "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Tagging xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><TagSet><Tag><Key>k1</Key><Value>v1</Value></Tag><Tag><Key>k2</Key><Value>v 2</Value></Tag></TagSet></Tagging>",
      "responseHeaders" : {
        "Content-Type" : "application/xml"
      },
      "status" : 200
    }
  ]
}
