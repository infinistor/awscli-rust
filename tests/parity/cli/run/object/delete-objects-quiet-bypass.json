{
  "args" : [
    "--delete-objects",
    "-b",
    "bucket1",
    "-f",
    "keys.json",
    "--quiet",
    "--bypass"
  ],
  "files" : {
    "keys.json" : "[\n  { \"Key\": \"Key1\", \"VersionId\": \"VersionId1\" },\n  { \"Key\": \"한글 키.txt\" }\n]"
  },
  "routes" : [
    {
      "contains" : "?delete",
      "responseBody" : "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<DeleteResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"></DeleteResult>",
      "responseHeaders" : {
        "Content-Type" : "application/xml"
      },
      "status" : 200
    }
  ]
}
