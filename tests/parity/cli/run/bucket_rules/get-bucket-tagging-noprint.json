{
  "args" : [
    "--get-bucket-tagging",
    "-b",
    "bucket1",
    "--print=false"
  ],
  "routes" : [
    {
      "contains" : "?tagging HTTP",
      "responseBody" : "<Tagging xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><TagSet><Tag><Key>k1</Key><Value>v1</Value></Tag><Tag><Key>k2</Key><Value>한글 값</Value></Tag></TagSet></Tagging>",
      "responseHeaders" : {
        "Content-Type" : "application/xml"
      },
      "status" : 200
    }
  ]
}
