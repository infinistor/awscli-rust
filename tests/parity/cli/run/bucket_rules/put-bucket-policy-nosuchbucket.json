{
  "args" : [
    "--put-bucket-policy",
    "-b",
    "bucket1",
    "-f",
    "in.json"
  ],
  "files" : {
    "in.json" : "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"*\"},\"Action\":\"s3:ListBucket\",\"Resource\":[\"arn:aws:s3:::bucket1\",\"arn:aws:s3:::bucket1/*\"]}]}"
  },
  "routes" : [
    {
      "contains" : "?policy HTTP",
      "responseBody" : "<Error><Code>NoSuchBucket</Code><Message>The specified bucket does not exist</Message><RequestId>REQ1</RequestId></Error>",
      "responseHeaders" : {
        "Content-Type" : "application/xml"
      },
      "status" : 404
    }
  ]
}
