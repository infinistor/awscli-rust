{
  "args" : [
    "--get-bucket-policy",
    "-b",
    "bucket1"
  ],
  "routes" : [
    {
      "contains" : "?policy HTTP",
      "responseBody" : "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":{\"AWS\":\"*\"},\"Action\":\"s3:ListBucket\",\"Resource\":[\"arn:aws:s3:::bucket1\",\"arn:aws:s3:::bucket1/*\"]}]}",
      "responseHeaders" : {
        "Content-Type" : "application/json"
      },
      "status" : 200
    }
  ]
}
