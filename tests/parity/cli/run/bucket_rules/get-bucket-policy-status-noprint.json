{
  "args" : [
    "--get-bucket-policy-status",
    "-b",
    "bucket1",
    "--print=false"
  ],
  "routes" : [
    {
      "contains" : "?policyStatus HTTP",
      "responseBody" : "<PolicyStatus xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><IsPublic>false</IsPublic></PolicyStatus>",
      "responseHeaders" : {
        "Content-Type" : "application/xml"
      },
      "status" : 200
    }
  ]
}
