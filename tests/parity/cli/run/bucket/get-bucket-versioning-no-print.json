{
  "args" : [
    "--get-bucket-versioning",
    "-b",
    "bucket1",
    "--print=false"
  ],
  "dump" : true,
  "routes" : [
    {
      "contains" : "GET /bucket1/?versioning",
      "responseBody" : "<?xml version=\"1.0\" encoding=\"UTF-8\"?><VersioningConfiguration xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Status>Enabled</Status><MfaDelete>Disabled</MfaDelete></VersioningConfiguration>",
      "responseHeaders" : {
        "Content-Type" : "application/xml"
      },
      "status" : 200
    }
  ]
}
