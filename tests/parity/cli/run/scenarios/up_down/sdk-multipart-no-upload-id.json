{
  "args": [
    "--test-multipart-upload"
  ],
  "config": "[Default]\nBucketName = bkt\nObjectPrefix = temp\nFileSize = 12K\nPartSize = 5K\nFilePath = data\n\n[UpDown]\nThreadCount = 1\nFileCount = 1\nTimes = 1\nBucketType = 0\nReadRatio = 1\nWriteRatio = 1\nDeleteRatio = 0\n\n[Main User]\nURL = {URL}\nAccessKey = testcore-access\nSecretKey = testcore-secret-key-0123456789abcdefghij\n",
  "ignore_body": true,
  "routes": [
    {
      "status": 200,
      "responseBody": "<InitiateMultipartUploadResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Bucket>bkt</Bucket><Key>k</Key></InitiateMultipartUploadResult>",
      "contains": "?uploads"
    },
    {
      "responseHeaders": {
        "ETag": "\"etag-part\""
      },
      "status": 200,
      "responseBody": "",
      "contains": "partNumber"
    },
    {
      "status": 200,
      "responseBody": "<CompleteMultipartUploadResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Location>http://x/bkt/k</Location><Bucket>bkt</Bucket><Key>k</Key><ETag>\"etag1\"</ETag></CompleteMultipartUploadResult>",
      "contains": "?uploadId"
    }
  ],
  "stats": true
}
