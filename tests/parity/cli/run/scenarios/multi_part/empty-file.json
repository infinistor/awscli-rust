{
  "args": [
    "--manual-upload",
    "-b",
    "mp",
    "-k",
    "obj.txt",
    "-f",
    "data.txt"
  ],
  "files": {
    "data.txt": ""
  },
  "drop_lines": "Manual Upload End",
  "routes": [
    {
      "contains": "POST /mp/obj.txt?uploads",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<InitiateMultipartUploadResult><Bucket>mp</Bucket><Key>obj.txt</Key><UploadId>UP1</UploadId></InitiateMultipartUploadResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "POST /mp/obj.txt?uploadId=UP1",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<CompleteMultipartUploadResult><Location>http://x/mp/obj.txt</Location><Bucket>mp</Bucket><Key>obj.txt</Key><ETag>&quot;final-1&quot;</ETag></CompleteMultipartUploadResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    }
  ]
}
