{
  "args": [
    "--test-directory-download",
    "-b",
    "md",
    "-f",
    "dl/",
    "--thread",
    "1"
  ],
  "stats": true,
  "drop_lines": "^ (Read Average|Bandwidth|Times)\\s",
  "outputs": [
    "dl"
  ],
  "files": {
    "dl/00": "x"
  },
  "routes": [
    {
      "contains": "GET /md/?",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ListBucketResult><Name>md</Name><Prefix></Prefix><Marker></Marker><MaxKeys>1000</MaxKeys><IsTruncated>false</IsTruncated><Contents><Key>a.txt</Key><LastModified>2026-03-04T05:06:07.000Z</LastModified><ETag>&quot;e&quot;</ETag><Size>3</Size><StorageClass>STANDARD</StorageClass></Contents><Contents><Key>b/c.txt</Key><LastModified>2026-03-04T05:06:07.000Z</LastModified><ETag>&quot;e&quot;</ETag><Size>3</Size><StorageClass>STANDARD</StorageClass></Contents></ListBucketResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "GET /md/a.txt",
      "status": 200,
      "responseBody": "AAA"
    },
    {
      "contains": "GET /md/b/c.txt",
      "status": 200,
      "responseBody": "CCCC"
    },
    {
      "contains": "GET /md/last.txt",
      "status": 200,
      "responseBody": "L"
    }
  ]
}
