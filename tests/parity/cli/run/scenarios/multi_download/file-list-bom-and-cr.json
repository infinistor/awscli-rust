{
  "args": [
    "--test-file-list=keys.txt",
    "-b",
    "md",
    "-f",
    "dl",
    "--thread",
    "1"
  ],
  "stats": true,
  "drop_lines": "^ (Read Average|Bandwidth|Times)\\s",
  "outputs": [
    "dl"
  ],
  "files": {
    "dl/00": "x",
    "keys.txt": "﻿a.txt\rb/c.txt\r"
  },
  "routes": [
    {
      "contains": "GET /md/a.txt",
      "status": 200,
      "responseBody": "AAA"
    },
    {
      "contains": "GET /md/b/c.txt",
      "status": 200,
      "responseBody": "CCCC"
    },
    {
      "contains": "GET /md/last.txt",
      "status": 200,
      "responseBody": "L"
    }
  ]
}
