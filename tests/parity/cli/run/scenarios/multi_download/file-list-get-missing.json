{
  "args": [
    "--test-file-list=keys.txt",
    "-b",
    "md",
    "-f",
    "dl",
    "--thread",
    "1"
  ],
  "stats": true,
  "drop_lines": "^ (Read Average|Bandwidth|Times)\\s",
  "outputs": [
    "dl"
  ],
  "files": {
    "dl/00": "x",
    "keys.txt": "a.txt\nb/c.txt\n"
  },
  "routes": [
    {
      "contains": "GET /md/a.txt",
      "status": 404,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Error><Code>NoSuchKey</Code><Message>The specified key does not exist.</Message><RequestId>REQ1</RequestId></Error>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "GET /md/b/c.txt",
      "status": 200,
      "responseBody": "CCCC"
    }
  ]
}
