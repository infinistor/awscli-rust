{
  "args": [
    "--test-directory-download",
    "-b",
    "md",
    "-f",
    "dl",
    "--thread",
    "1"
  ],
  "stats": true,
  "drop_lines": "^ (Read Average|Bandwidth|Times)\\s",
  "outputs": [
    "dl"
  ],
  "files": {
    "dl/00": "x"
  },
  "routes": [
    {
      "contains": "GET /md/?",
      "status": 403,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Error><Code>AccessDenied</Code><Message>Access Denied</Message><RequestId>REQ1</RequestId></Error>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    }
  ]
}
