{
  "args": [
    "--test-directory-download",
    "-b",
    "md",
    "-f",
    "dl",
    "--thread",
    "1"
  ],
  "stats": true,
  "drop_lines": "^ (Read Average|Bandwidth|Times)\\s",
  "outputs": [
    "dl"
  ],
  "files": {
    "dl/00": "x"
  },
  "routes": [
    {
      "contains": "GET /md/?",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<ListBucketResult><Name>md</Name><Prefix></Prefix><Marker></Marker><MaxKeys>1000</MaxKeys><IsTruncated>false</IsTruncated></ListBucketResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    }
  ]
}
