{
  "args": [
    "--test-multi-upload",
    "-b",
    "mu",
    "-k",
    "key",
    "--thread",
    "3",
    "--size",
    "3",
    "--part-size",
    "2"
  ],
  "ignore_body": true,
  "unordered": true,
  "drop_lines": "Body does not match|Length :|Size :",
  "routes": [
    {
      "contains": "POST /mu/key0?uploads",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<InitiateMultipartUploadResult><Bucket>mu</Bucket><Key>key0</Key><UploadId>UP1</UploadId></InitiateMultipartUploadResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "POST /mu/key1?uploads",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<InitiateMultipartUploadResult><Bucket>mu</Bucket><Key>key0</Key><UploadId>UP1</UploadId></InitiateMultipartUploadResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "POST /mu/key2?uploads",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<InitiateMultipartUploadResult><Bucket>mu</Bucket><Key>key0</Key><UploadId>UP1</UploadId></InitiateMultipartUploadResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "partNumber=1",
      "status": 200,
      "responseHeaders": {
        "ETag": "\"etag1\""
      }
    },
    {
      "contains": "partNumber=2",
      "status": 200,
      "responseHeaders": {
        "ETag": "\"etag2\""
      }
    },
    {
      "contains": "POST /mu/key0?uploadId=UP1",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<CompleteMultipartUploadResult><Location>http://x/mu/key0</Location><Bucket>mu</Bucket><Key>key0</Key><ETag>&quot;final-1&quot;</ETag></CompleteMultipartUploadResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "POST /mu/key1?uploadId=UP1",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<CompleteMultipartUploadResult><Location>http://x/mu/key0</Location><Bucket>mu</Bucket><Key>key0</Key><ETag>&quot;final-1&quot;</ETag></CompleteMultipartUploadResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "POST /mu/key2?uploadId=UP1",
      "status": 200,
      "responseBody": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<CompleteMultipartUploadResult><Location>http://x/mu/key0</Location><Bucket>mu</Bucket><Key>key0</Key><ETag>&quot;final-1&quot;</ETag></CompleteMultipartUploadResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "HEAD /mu/key",
      "status": 200,
      "responseBody": "012"
    },
    {
      "contains": "GET /mu/key",
      "status": 206,
      "responseBody": "a"
    }
  ]
}
