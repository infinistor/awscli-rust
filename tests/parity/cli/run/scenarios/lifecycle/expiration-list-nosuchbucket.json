{
  "args": [
    "--test-compare-lifecycle",
    "-b",
    "bkt"
  ],
  "routes": [
    {
      "contains": "GET /bkt/?versioning",
      "status": 200,
      "responseBody": "<VersioningConfiguration xmlns='http://s3.amazonaws.com/doc/2006-03-01/'><Status>Enabled</Status></VersioningConfiguration>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "GET /bkt/?lifecycle",
      "status": 200,
      "responseBody": "<LifecycleConfiguration xmlns='http://s3.amazonaws.com/doc/2006-03-01/'><Rule><ID>r1</ID><Status>Enabled</Status><Expiration><Days>30</Days></Expiration></Rule></LifecycleConfiguration>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "GET /bkt/?",
      "status": 404,
      "responseBody": "<Error><Code>NoSuchBucket</Code><Message>nb</Message><RequestId>r1</RequestId></Error>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    }
  ]
}
