{
  "args": [
    "--test-compare-lifecycle",
    "-b",
    "bkt"
  ],
  "routes": [
    {
      "contains": "GET /bkt/?versioning",
      "status": 200,
      "responseBody": "<VersioningConfiguration xmlns='http://s3.amazonaws.com/doc/2006-03-01/'><Status>enabled</Status></VersioningConfiguration>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "GET /bkt/?lifecycle",
      "status": 200,
      "responseBody": "<LifecycleConfiguration xmlns='http://s3.amazonaws.com/doc/2006-03-01/'><Rule><ID>r1</ID><Status>Enabled</Status><NoncurrentVersionExpiration><NoncurrentDays>30</NoncurrentDays></NoncurrentVersionExpiration></Rule></LifecycleConfiguration>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "GET /bkt/?versions",
      "status": 200,
      "responseBody": "<ListVersionsResult xmlns='http://s3.amazonaws.com/doc/2006-03-01/'><Name>bkt</Name><Prefix></Prefix><KeyMarker></KeyMarker><VersionIdMarker></VersionIdMarker><MaxKeys>1000</MaxKeys><IsTruncated>false</IsTruncated><Version><Key>x</Key><VersionId>v1</VersionId><IsLatest>true</IsLatest><LastModified>2099-01-01T00:00:00.000Z</LastModified><ETag>e</ETag><Size>1</Size><StorageClass>STANDARD</StorageClass></Version></ListVersionsResult>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    }
  ],
  "drop_lines": "expiredDate :"
}
