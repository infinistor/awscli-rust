{
  "args": [
    "--test-compare-lifecycle",
    "-b",
    "bkt"
  ],
  "routes": [
    {
      "contains": "GET /bkt/?versioning",
      "status": 200,
      "responseBody": "<VersioningConfiguration xmlns='http://s3.amazonaws.com/doc/2006-03-01/'><Status>Enabled</Status></VersioningConfiguration>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    },
    {
      "contains": "GET /bkt/?lifecycle",
      "status": 404,
      "responseBody": "<Error><Code>NoSuchLifecycleConfiguration</Code><Message>The lifecycle configuration does not exist</Message><RequestId>r1</RequestId></Error>",
      "responseHeaders": {
        "Content-Type": "application/xml"
      }
    }
  ]
}
