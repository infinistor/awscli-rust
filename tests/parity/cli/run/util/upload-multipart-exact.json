{
   "args" : [
      "--upload",
      "-b",
      "bucket1",
      "-f",
      "big.bin",
      "-k",
      "big.bin",
      "--part-size",
      "1K"
   ],
   "files" : {
      "big.bin" : ""
   },
   "routes" : [
      {
         "contains" : "POST /bucket1/big.bin?uploads",
         "responseBody" : "<InitiateMultipartUploadResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Bucket>bucket1</Bucket><Key>big.bin</Key><UploadId>UP1</UploadId></InitiateMultipartUploadResult>",
         "responseHeaders" : {
            "Content-Type" : "application/xml"
         },
         "status" : 200
      },
      {
         "contains" : "partNumber=",
         "responseHeaders" : {
            "ETag" : "\"partetag\""
         },
         "status" : 200
      },
      {
         "contains" : "POST /bucket1/big.bin?uploadId=UP1",
         "responseBody" : "<CompleteMultipartUploadResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Location>http://x/bucket1/big.bin</Location><Bucket>bucket1</Bucket><Key>big.bin</Key><ETag>&quot;abc-3&quot;</ETag></CompleteMultipartUploadResult>",
         "responseHeaders" : {
            "Content-Type" : "application/xml"
         },
         "status" : 200
      }
   ],
   "unordered" : true
}
