    { "contains" : "partNumber", "status" : 200, "responseBody" : "", "responseHeaders" : { "ETag" : "\"p\"" } },
    { "contains" : "uploadId", "status" : 200, "responseBody" : "<CompleteMultipartUploadResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><ETag>&quot;f&quot;</ETag></CompleteMultipartUploadResult>", "responseHeaders" : { "Content-Type" : "application/xml" } }
  ],
  "files" : { "big.bin" : "" },
  "unordered" : true
