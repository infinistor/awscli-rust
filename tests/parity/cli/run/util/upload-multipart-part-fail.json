{
   "args" : [
      "--upload",
      "-b",
      "bucket1",
      "-f",
      "big.bin",
      "-k",
      "big.bin",
      "--part-size",
      "1K"
   ],
   "files" : {
      "big.bin" : ""
   },
   "routes" : [
      {
         "contains" : "POST /bucket1/big.bin?uploads",
         "responseBody" : "<InitiateMultipartUploadResult xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Bucket>bucket1</Bucket><Key>big.bin</Key><UploadId>UP1</UploadId></InitiateMultipartUploadResult>",
         "responseHeaders" : {
            "Content-Type" : "application/xml"
         },
         "status" : 200
      },
      {
         "contains" : "partNumber=",
         "responseBody" : "<Error><Code>AccessDenied</Code><Message>Access Denied</Message><RequestId>REQ1</RequestId></Error>",
         "responseHeaders" : {
            "Content-Type" : "application/xml"
         },
         "status" : 403
      },
      {
         "contains" : "DELETE /bucket1/big.bin?uploadId=UP1",
         "status" : 204
      }
   ],
   "unordered" : true
}
