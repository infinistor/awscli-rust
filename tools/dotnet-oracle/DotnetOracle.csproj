<Project Sdk="Microsoft.NET.Sdk">
	<!-- TESTCore 빌드 결과(TestCore.dll)를 그대로 호출해 parity 기준 출력을 만든다. TESTCore 원본은 수정하지 않는다. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<TestCoreBin Condition="'$(TestCoreBin)' == ''">$(MSBuildThisFileDirectory)..\..\..\TESTCore\bin\TestCore</TestCoreBin>
	</PropertyGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<Reference Include="TestCore">
			<HintPath>$(TestCoreBin)\TestCore.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>
